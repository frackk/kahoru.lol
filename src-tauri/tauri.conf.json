{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kahoru.lol",
  "version": "0.2.0",
  "identifier": "one.frack.kahoru",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kahoru.lol",
        "width": 1200,
        "height": 800,
        "minWidth": 850,
        "minHeight": 640,
        "backgroundColor": "#10151f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "scope": ["$APPCACHE/game/**"],
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "frack.one",
    "copyright": "made by frack.one",
    "shortDescription": "Preparación de partidas de League of Legends",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
